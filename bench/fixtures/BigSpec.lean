import LeanSpec
open LeanSpec.Core Lean

/-- The payment shall be the fixed annuity payment principal * r / (1 - (1 + r)^-months), with r = annual_rate_bp / 120000, rounded half-up to whole ore. -/
@[requirement must] def R1 : IOSig → Prop := Req.holds [
      ex "annuity_3_months" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3}) (json% {"payment": 34002, "schedule": [{"month": 1, "interest": 1000, "principal": 33002, "balance": 66998}, {"month": 2, "interest": 670, "principal": 33332, "balance": 33666}, {"month": 3, "interest": 337, "principal": 33666, "balance": 0}], "total_interest": 2007}),
      ex "payment_rounds_half_up" (json% {"principal": 60000, "annual_rate_bp": 1, "months": 1}) (json% {"payment": 60001, "schedule": [{"month": 1, "interest": 1, "principal": 60000, "balance": 0}], "total_interest": 1})]
/-- When annual_rate_bp is 0 the payment shall be principal / months rounded half-up to whole ore. -/
@[requirement must] def R2 : IOSig → Prop := Req.holds [
      ex "zero_rate_thirds" (json% {"principal": 1000, "annual_rate_bp": 0, "months": 3}) (json% {"payment": 333, "schedule": [{"month": 1, "interest": 0, "principal": 333, "balance": 667}, {"month": 2, "interest": 0, "principal": 333, "balance": 334}, {"month": 3, "interest": 0, "principal": 334, "balance": 0}], "total_interest": 0}),
      ex "zero_rate_half_up" (json% {"principal": 5, "annual_rate_bp": 0, "months": 2}) (json% {"payment": 3, "schedule": [{"month": 1, "interest": 0, "principal": 3, "balance": 2}, {"month": 2, "interest": 0, "principal": 2, "balance": 0}], "total_interest": 0})]
/-- Each month's interest shall be balance * annual_rate_bp / 120000 rounded half-up to whole ore. -/
@[requirement must] def R3 : IOSig → Prop := Req.holds [
      ex "interest_12_months" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 12}) (json% {"payment": 8885, "schedule": [{"month": 1, "interest": 1000, "principal": 7885, "balance": 92115}, {"month": 2, "interest": 921, "principal": 7964, "balance": 84151}, {"month": 3, "interest": 842, "principal": 8043, "balance": 76108}, {"month": 4, "interest": 761, "principal": 8124, "balance": 67984}, {"month": 5, "interest": 680, "principal": 8205, "balance": 59779}, {"month": 6, "interest": 598, "principal": 8287, "balance": 51492}, {"month": 7, "interest": 515, "principal": 8370, "balance": 43122}, {"month": 8, "interest": 431, "principal": 8454, "balance": 34668}, {"month": 9, "interest": 347, "principal": 8538, "balance": 26130}, {"month": 10, "interest": 261, "principal": 8624, "balance": 17506}, {"month": 11, "interest": 175, "principal": 8710, "balance": 8796}, {"month": 12, "interest": 88, "principal": 8796, "balance": 0}], "total_interest": 6619}),
      ex "interest_half_up_one_month" (json% {"principal": 60000, "annual_rate_bp": 1, "months": 1}) (json% {"payment": 60001, "schedule": [{"month": 1, "interest": 1, "principal": 60000, "balance": 0}], "total_interest": 1})]
/-- Each month's principal shall be payment - interest, except that the last month, or any month where payment - interest >= balance, shall pay the remaining balance so the balance ends at 0. -/
@[requirement must] def R4 : IOSig → Prop := Req.holds [
      ex "early_stop_when_payment_covers_balance" (json% {"principal": 2, "annual_rate_bp": 0, "months": 3}) (json% {"payment": 1, "schedule": [{"month": 1, "interest": 0, "principal": 1, "balance": 1}, {"month": 2, "interest": 0, "principal": 1, "balance": 0}], "total_interest": 0}),
      ex "last_month_takes_remaining_balance" (json% {"principal": 5, "annual_rate_bp": 0, "months": 2}) (json% {"payment": 3, "schedule": [{"month": 1, "interest": 0, "principal": 3, "balance": 2}, {"month": 2, "interest": 0, "principal": 2, "balance": 0}], "total_interest": 0})]
/-- The schedule shall stop as soon as the balance reaches 0, and months shall be numbered from 1. -/
@[requirement must] def R5 : IOSig → Prop := Req.holds [
      ex "balance_reaches_zero_before_term" (json% {"principal": 2, "annual_rate_bp": 0, "months": 3}) (json% {"payment": 1, "schedule": [{"month": 1, "interest": 0, "principal": 1, "balance": 1}, {"month": 2, "interest": 0, "principal": 1, "balance": 0}], "total_interest": 0}),
      ex "term_of_four_months" (json% {"principal": 12345, "annual_rate_bp": 600, "months": 4}) (json% {"payment": 3125, "schedule": [{"month": 1, "interest": 62, "principal": 3063, "balance": 9282}, {"month": 2, "interest": 46, "principal": 3079, "balance": 6203}, {"month": 3, "interest": 31, "principal": 3094, "balance": 3109}, {"month": 4, "interest": 16, "principal": 3109, "balance": 0}], "total_interest": 155})]
/-- The output shall be one JSON object with payment, schedule (month, interest, principal, balance after the month), and total_interest equal to the sum of interest. -/
@[requirement must] def R6 : IOSig → Prop := Req.holds [
      ex "total_interest_is_sum" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3}) (json% {"payment": 34002, "schedule": [{"month": 1, "interest": 1000, "principal": 33002, "balance": 66998}, {"month": 2, "interest": 670, "principal": 33332, "balance": 33666}, {"month": 3, "interest": 337, "principal": 33666, "balance": 0}], "total_interest": 2007})]
