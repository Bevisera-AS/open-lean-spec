/-- An optional extra list of {month, amount} shall add each amount to that month's principal after the regular payment, capped at the remaining balance, without changing the payment or the interest of that month. Several entries for one month shall add together. The schedule shall stop when the balance reaches 0. -/
@[requirement must] def R8 : IOSig → Prop := Req.holds [
      ex "extra_applied_to_principal" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3, "extra": [{"month": 1, "amount": 10000}]}) (json% {"payment": 34002, "schedule": [{"month": 1, "interest": 1000, "principal": 43002, "balance": 56998}, {"month": 2, "interest": 570, "principal": 33432, "balance": 23566}, {"month": 3, "interest": 236, "principal": 23566, "balance": 0}], "total_interest": 1806}),
      ex "extra_capped_at_balance" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3, "extra": [{"month": 2, "amount": 1000000000}]}) (json% {"payment": 34002, "schedule": [{"month": 1, "interest": 1000, "principal": 33002, "balance": 66998}, {"month": 2, "interest": 670, "principal": 66998, "balance": 0}], "total_interest": 1670}),
      ex "extra_same_month_adds" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3, "extra": [{"month": 1, "amount": 5000}, {"month": 1, "amount": 5000}]}) (json% {"payment": 34002, "schedule": [{"month": 1, "interest": 1000, "principal": 43002, "balance": 56998}, {"month": 2, "interest": 570, "principal": 33432, "balance": 23566}, {"month": 3, "interest": 236, "principal": 23566, "balance": 0}], "total_interest": 1806}),
      ex "extra_list_empty" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3, "extra": []}) (json% {"payment": 34002, "schedule": [{"month": 1, "interest": 1000, "principal": 33002, "balance": 66998}, {"month": 2, "interest": 670, "principal": 33332, "balance": 33666}, {"month": 3, "interest": 337, "principal": 33666, "balance": 0}], "total_interest": 2007})]
/-- An optional interest_only_months k (0 <= k < months) shall make the first k months interest only: interest is charged, principal is 0 and the balance is unchanged. The payment shall be the annuity over months - k on the full principal and shall apply from month k+1; output payment is that amount. Extra payments still apply in interest-only months. -/
@[requirement must] def R9 : IOSig → Prop := Req.holds [
      ex "interest_only_then_annuity" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3, "interest_only_months": 1}) (json% {"payment": 50751, "schedule": [{"month": 1, "interest": 1000, "principal": 0, "balance": 100000}, {"month": 2, "interest": 1000, "principal": 49751, "balance": 50249}, {"month": 3, "interest": 502, "principal": 50249, "balance": 0}], "total_interest": 2502}),
      ex "interest_only_with_extra" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3, "extra": [{"month": 1, "amount": 1000}], "interest_only_months": 1}) (json% {"payment": 50751, "schedule": [{"month": 1, "interest": 1000, "principal": 1000, "balance": 99000}, {"month": 2, "interest": 990, "principal": 49761, "balance": 49239}, {"month": 3, "interest": 492, "principal": 49239, "balance": 0}], "total_interest": 2482}),
      ex "interest_only_zero_rate" (json% {"principal": 1000, "annual_rate_bp": 0, "months": 4, "interest_only_months": 2}) (json% {"payment": 500, "schedule": [{"month": 1, "interest": 0, "principal": 0, "balance": 1000}, {"month": 2, "interest": 0, "principal": 0, "balance": 1000}, {"month": 3, "interest": 0, "principal": 500, "balance": 500}, {"month": 4, "interest": 0, "principal": 500, "balance": 0}], "total_interest": 0}),
      ex "interest_only_all_but_one" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3, "interest_only_months": 2}) (json% {"payment": 101000, "schedule": [{"month": 1, "interest": 1000, "principal": 0, "balance": 100000}, {"month": 2, "interest": 1000, "principal": 0, "balance": 100000}, {"month": 3, "interest": 1000, "principal": 100000, "balance": 0}], "total_interest": 3000}),
      ex "no_interest_only_months" (json% {"principal": 100000, "annual_rate_bp": 1200, "months": 3, "interest_only_months": 0}) (json% {"payment": 34002, "schedule": [{"month": 1, "interest": 1000, "principal": 33002, "balance": 66998}, {"month": 2, "interest": 670, "principal": 33332, "balance": 33666}, {"month": 3, "interest": 337, "principal": 33666, "balance": 0}], "total_interest": 2007})]
